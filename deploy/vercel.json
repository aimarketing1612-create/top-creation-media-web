{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "topcreation.media"
        }
      ],
      "destination": "https://www.topcreationmedia.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.topcreation.media"
        }
      ],
      "destination": "https://www.topcreationmedia.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "topcreationmedia.com"
        }
      ],
      "destination": "https://www.topcreationmedia.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "topcreation.media"
        }
      ],
      "destination": "https://www.topcreationmedia.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.topcreation.media"
        }
      ],
      "destination": "https://www.topcreationmedia.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "topcreationmedia.com"
        }
      ],
      "destination": "https://www.topcreationmedia.com/:path*",
      "permanent": true
    },
    {
      "source": "/social-media",
      "destination": "/marketing-services",
      "permanent": true
    },
    {
      "source": "/zh/social-media",
      "destination": "/zh/marketing-services",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
